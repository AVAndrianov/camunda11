{
  "info": {
    "name": "PandaPay API V1",
    "_postman_id": "7a0d6ee5-0d4b-4ba2-bdd9-3e6c2d7a9b0a",
    "description": "REST API V1 for merchant operations. Requests must be signed with HMAC-SHA256. Headers: X-API-Key, X-Timestamp, X-Signature. Base: https://api.pandapay24.com/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(() => {",
          "  try {",
          "    const cryptoAvailable = (typeof crypto !== 'undefined' && typeof crypto.createHmac === 'function');",
          "    const method = pm.request.method;",
          "    const url = pm.request.url;",
          "    const path = url.getPath();",
          "    const query = url.getQueryString() || '';",
          "    let raw = '';",
          "    if (pm.request.body && pm.request.body.mode === 'raw') {",
          "      raw = pm.variables.replaceIn(pm.request.body.raw || '');",
          "    }",
          "    const timestamp = Math.floor(Date.now() / 1000).toString();",
          "    pm.environment.set('X_Timestamp', timestamp);",
          "    const keyId = pm.environment.get('KEY_ID') || pm.collectionVariables.get('KEY_ID') || '';",
          "    const secret = pm.environment.get('SECRET_KEY') || pm.collectionVariables.get('SECRET_KEY') || '';",
          "    let bodyHashHex = '';",
          "    let signatureHex = '';",
          "    if (cryptoAvailable) {",
          "      bodyHashHex = crypto.createHash('sha256').update(raw, 'utf8').digest('hex');",
          "      const canonical = [method, path, query, timestamp, bodyHashHex].join('\n');",
          "      signatureHex = crypto.createHmac('sha256', secret).update(canonical, 'utf8').digest('hex');",
          "    } else {",
          "      const canonical = [method, path, query, timestamp, ''].join('\n');",
          "      signatureHex = canonical;",
          "    }",
          "    pm.environment.set('signatureHex', signatureHex);",
          "    pm.request.headers.upsert({ key: 'X-API-Key', value: keyId });",
          "    pm.request.headers.upsert({ key: 'X-Timestamp', value: timestamp });",
          "    pm.request.headers.upsert({ key: 'X-Signature', value: signatureHex });",
          "    const token = (pm.environment.get('token') || '').trim();",
          "    if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "  } catch (e) { console.error('pre-request error:', e); }",
          "})();"
        ]
      }
    }
  ],
  "item": [
