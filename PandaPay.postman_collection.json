{
  "info": {
    "name": "PandaPay API V1",
    "_postman_id": "7a0d6ee5-0d4b-4ba2-bdd9-3e6c2d7a9b0a",
    "description": "REST API V1 for merchant operations. HMAC-SHA256 signing required (X-API-Key, X-Timestamp, X-Signature). Base: https://api.pandapay24.com/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(() => {",
          "  try {",
          "    const url = pm.request.url;",
          "    const path = (typeof url === 'string') ? new URL(url.replace('{{BASE_URL}}', pm.environment.get('BASE_URL')||'' )).pathname : url.getPath();",
          "    const timestamp = Math.floor(Date.now() / 1000).toString();",
          "    pm.environment.set('X_Timestamp', timestamp);",
          "    const keyId = pm.environment.get('KEY_ID') || pm.collectionVariables.get('KEY_ID') || '';",
          "    const secret = pm.environment.get('SECRET_KEY') || pm.collectionVariables.get('SECRET_KEY') || '';",
          "    let raw = '';",
          "    if (pm.request.body && pm.request.body.mode === 'raw') {",
          "      raw = pm.variables.replaceIn(pm.request.body.raw || '');",
          "    }",
          "    let stringToSign = '';",
          "    if (pm.request.body && pm.request.body.mode === 'formdata') {",
          "      stringToSign = timestamp + path;",
          "    } else if (raw) {",
          "      stringToSign = timestamp + raw;",
          "    } else {",
          "      stringToSign = timestamp;",
          "    }",
          "    let signatureHex = stringToSign;",
          "    if (typeof crypto !== 'undefined' && typeof crypto.createHmac === 'function') {",
          "      signatureHex = crypto.createHmac('sha256', secret).update(stringToSign, 'utf8').digest('hex');",
          "    }",
          "    pm.environment.set('signatureHex', signatureHex);",
          "    pm.request.headers.upsert({ key: 'X-API-Key', value: keyId });",
          "    pm.request.headers.upsert({ key: 'X-Timestamp', value: timestamp });",
          "    pm.request.headers.upsert({ key: 'X-Signature', value: signatureHex });",
          "    const token = (pm.environment.get('token') || '').trim();",
          "    if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "  } catch (e) { console.error('pre-request error:', e); }",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Balance History: GET /balance-history",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{KEY_ID}}" },
          { "key": "X-Timestamp", "value": "{{X_Timestamp}}" },
          { "key": "X-Signature", "value": "{{signatureHex}}" }
        ],
        "url": "{{BASE_URL}}/balance-history?page={{page}}&per_page={{per_page}}&history_type={{history_type}}&from_date={{from_date}}&to_date={{to_date}}&order_id={{order_id}}"
      }
    },
    {
      "name": "Disputes: GET /disputes",
