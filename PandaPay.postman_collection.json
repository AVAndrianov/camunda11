          "formdata": [
            { "key": "order_id", "type": "text", "value": "" },
            { "key": "reason", "type": "text", "value": "amount_mismatch" },
            { "key": "amount", "type": "text", "value": "" },
            { "key": "details", "type": "text", "value": "" },
            { "key": "evidence", "type": "file", "src": "" }
          ]
        },
        "url": "{{BASE_URL}}/disputes"
      }
    },
    {
